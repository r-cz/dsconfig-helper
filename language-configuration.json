{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "wordPattern": "(--?[A-Za-z][A-Za-z0-9-]*)|(-?\\d*\\.\\d\\w*)|([A-Za-z_][A-Za-z0-9_-]*)",
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\S.*\\\\\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s+[^#\\s].*[^\\\\\\s]\\s*$",
      "previousLineText": "\\\\\\s*$",
      "action": { "indent": "outdent" }
    }
  ]
}
