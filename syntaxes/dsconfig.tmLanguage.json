{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PingDirectory dsconfig",
  "scopeName": "source.dsconfig",
  "patterns": [
    { "include": "#comment" },
    { "include": "#lineContinuation" },
    { "include": "#command" },
    { "include": "#quotedPropertyAssignmentDouble" },
    { "include": "#quotedPropertyAssignmentSingle" },
    { "include": "#propertyAssignment" },
    { "include": "#propertyName" },
    { "include": "#typeArgument" },
    { "include": "#namingArgument" },
    { "include": "#subcommand" },
    { "include": "#option" },
    { "include": "#string" },
    { "include": "#envVar" },
    { "include": "#boolean" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.dsconfig",
      "match": "^\\s*(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.dsconfig" }
      }
    },
    "lineContinuation": {
      "name": "punctuation.separator.continuation.dsconfig",
      "match": "\\\\(?=\\s*$)"
    },
    "command": {
      "match": "^\\s*((?i:dsconfig))(?=\\s|$)",
      "captures": {
        "1": { "name": "support.function.dsconfig" }
      }
    },
    "subcommand": {
      "name": "keyword.control.dsconfig",
      "match": "(?<=^|\\s)(?i:(?:create|delete|get|set|list)-[a-z][a-z0-9-]*)(?=\\s|$)"
    },
    "option": {
      "name": "variable.parameter.dsconfig",
      "match": "(?<=^|\\s)--?[A-Za-z][A-Za-z0-9-]*"
    },
    "envVar": {
      "name": "variable.other.environment.dsconfig",
      "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.dsconfig",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dsconfig" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.dsconfig" } },
          "patterns": [{ "include": "#escape" }, { "include": "#envVar" }]
        },
        {
          "name": "string.quoted.single.dsconfig",
          "begin": "'",
          "end": "'|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.dsconfig" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.dsconfig" } },
          "patterns": [{ "include": "#envVar" }]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.dsconfig",
      "match": "\\\\[\"\\\\]"
    },
    "boolean": {
      "name": "constant.language.boolean.dsconfig",
      "match": "(?<=^|\\s|[:<])(?i:true|false)(?=\\s|$|[\"'])"
    },
    "number": {
      "name": "constant.numeric.dsconfig",
      "match": "(?<=^|\\s|[:<])-?\\d+(?:\\.\\d+)?(?=\\s|$|[\"'])"
    },
    "propertyAssignment": {
      "begin": "(?<=^|\\s)((?i:--(?:set|add|remove)))\\s+([A-Za-z][A-Za-z0-9-]*)([:<])",
      "beginCaptures": {
        "1": { "name": "variable.parameter.dsconfig" },
        "2": { "name": "variable.other.property.dsconfig" },
        "3": { "name": "punctuation.separator.key-value.dsconfig" }
      },
      "end": "(?=\\s|$)",
      "patterns": [
        { "include": "#envVar" },
        { "include": "#string" },
        { "include": "#boolean" },
        { "include": "#number" },
        {
          "name": "string.unquoted.dsconfig",
          "match": "[^\\s\"'$]+|\\$"
        }
      ]
    },
    "quotedPropertyAssignmentDouble": {
      "begin": "(?<=^|\\s)((?i:--(?:set|add|remove)))\\s+(\")([A-Za-z][A-Za-z0-9-]*)([:<])",
      "beginCaptures": {
        "1": { "name": "variable.parameter.dsconfig" },
        "2": { "name": "string.quoted.double.dsconfig punctuation.definition.string.begin.dsconfig" },
        "3": { "name": "variable.other.property.dsconfig" },
        "4": { "name": "punctuation.separator.key-value.dsconfig" }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": { "name": "string.quoted.double.dsconfig punctuation.definition.string.end.dsconfig" }
      },
      "contentName": "string.quoted.double.dsconfig",
      "patterns": [
        { "include": "#escape" },
        { "include": "#envVar" },
        { "include": "#boolean" },
        { "include": "#number" }
      ]
    },
    "quotedPropertyAssignmentSingle": {
      "begin": "(?<=^|\\s)((?i:--(?:set|add|remove)))\\s+(')([A-Za-z][A-Za-z0-9-]*)([:<])",
      "beginCaptures": {
        "1": { "name": "variable.parameter.dsconfig" },
        "2": { "name": "string.quoted.single.dsconfig punctuation.definition.string.begin.dsconfig" },
        "3": { "name": "variable.other.property.dsconfig" },
        "4": { "name": "punctuation.separator.key-value.dsconfig" }
      },
      "end": "'|$",
      "endCaptures": {
        "0": { "name": "string.quoted.single.dsconfig punctuation.definition.string.end.dsconfig" }
      },
      "contentName": "string.quoted.single.dsconfig",
      "patterns": [{ "include": "#envVar" }, { "include": "#boolean" }, { "include": "#number" }]
    },
    "propertyName": {
      "match": "(?<=^|\\s)((?i:--(?:reset|property)))\\s+([\"']?)([A-Za-z][A-Za-z0-9-]*)(\\2)(?=\\s|$)",
      "captures": {
        "1": { "name": "variable.parameter.dsconfig" },
        "2": { "name": "punctuation.definition.string.begin.dsconfig" },
        "3": { "name": "variable.other.property.dsconfig" },
        "4": { "name": "punctuation.definition.string.end.dsconfig" }
      }
    },
    "typeArgument": {
      "match": "(?<=^|\\s)(--type|-t)\\s+([\"']?)([A-Za-z][A-Za-z0-9-]*)(\\2)(?=\\s|$)",
      "captures": {
        "1": { "name": "variable.parameter.dsconfig" },
        "2": { "name": "punctuation.definition.string.begin.dsconfig" },
        "3": { "name": "entity.name.type.dsconfig" },
        "4": { "name": "punctuation.definition.string.end.dsconfig" }
      }
    },
    "namingArgument": {
      "match": "(?<=^|\\s)((?i:--(?:[a-z0-9-]+-)?name))\\s+(?:((\")(?:\\\\.|[^\"\\\\])*(\"))|((')[^']*(')))?([^\\s\"'$#-][^\\s]*)?(?=\\s|$)",
      "captures": {
        "1": { "name": "variable.parameter.dsconfig" },
        "2": { "name": "string.quoted.double.dsconfig" },
        "3": { "name": "punctuation.definition.string.begin.dsconfig" },
        "4": { "name": "punctuation.definition.string.end.dsconfig" },
        "5": { "name": "string.quoted.single.dsconfig" },
        "6": { "name": "punctuation.definition.string.begin.dsconfig" },
        "7": { "name": "punctuation.definition.string.end.dsconfig" },
        "8": { "name": "string.unquoted.name.dsconfig" }
      }
    }
  }
}
